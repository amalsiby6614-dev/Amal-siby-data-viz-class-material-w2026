   "source": [
    "## 3. Stretch goal: GDP and freedom across five regions\n",
    "GDP per capita is reported as logged GDP in the source dataset; freedom is the survey measure of freedom to make life choices. Since the scales differ, interpret bar heights within each metric rather than directly as equivalent quantities."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "f612aba5",
   "metadata": {},
   "outputs": [],
   "source": [
    "regions_of_interest = [\n",
    "    \"Western Europe\", \"Latin America\", \"East Asia\",\n",
    "    \"Sub-Saharan Africa\", \"South Asia\"\n",
    "]\n",
    "region_factors = (\n",
    "    df[df[\"Region\"].isin(regions_of_interest)]\n",
    "    .groupby(\"Region\")\n",
    "    .agg(Average_GDP=(\"GDP\", \"mean\"), Average_Freedom=(\"Freedom\", \"mean\"))\n",
    "    .reindex(regions_of_interest)\n",
    ")\n",
    "\n",
    "x = np.arange(len(region_factors))\n",
    "width = 0.36\n",
    "fig, ax = plt.subplots(figsize=(11, 6))\n",
    "ax.bar(x - width/2, region_factors[\"Average_GDP\"], width, label=\"Logged GDP per capita\", color=\"#2878B5\")\n",
    "ax.bar(x + width/2, region_factors[\"Average_Freedom\"], width, label=\"Freedom score\", color=\"#E87532\")\n",
    "ax.set_xticks(x, region_factors.index, rotation=20, ha=\"right\")\n",
    "ax.set_ylabel(\"Regional mean (source metric scale)\")\n",
    "ax.set_title(\"GDP and freedom vary across the selected regions\")\n",
    "ax.set_ylim(0, max(region_factors[\"Average_GDP\"].max(), region_factors[\"Average_Freedom\"].max()) * 1.15)\n",
    "ax.grid(axis=\"y\", alpha=0.2)\n",
    "ax.set_axisbelow(True)\n",
    "ax.legend()\n",
    "fig.tight_layout()\n",
    "plt.show()\n",
    "display(region_factors.round(3))\n"
   ]
  }
