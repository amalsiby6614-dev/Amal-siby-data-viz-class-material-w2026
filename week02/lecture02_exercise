   "source": [
    "## 2. The happiness gap between the top and bottom eight countries\n",
    "Blue bars represent the top eight; orange bars represent the bottom eight. The dashed line marks the global average."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "fd98bc95",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Global average: 5.54 | Score gap: 5.95\n"
     ]
    }
   ],
   "source": [
    "global_average = df[\"Happiness_Score\"].mean()\n",
    "top_eight = df.nlargest(8, \"Happiness_Score\")[[\"Country\", \"Happiness_Score\"]].assign(Group=\"Top 8\")\n",
    "bottom_eight = df.nsmallest(8, \"Happiness_Score\")[[\"Country\", \"Happiness_Score\"]].assign(Group=\"Bottom 8\")\n",
    "comparison = pd.concat([bottom_eight, top_eight]).sort_values(\"Happiness_Score\")\n",
    "gap = df[\"Happiness_Score\"].max() - df[\"Happiness_Score\"].min()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 8))\n",
    "colors = comparison[\"Group\"].map({\"Top 8\": \"#2878B5\", \"Bottom 8\": \"#E87532\"})\n",
    "bars = ax.barh(comparison[\"Country\"], comparison[\"Happiness_Score\"], color=colors)\n",
    "ax.bar_label(bars, fmt=\"%.2f\", padding=3, fontsize=8)\n",
    "ax.axvline(global_average, color=\"black\", linestyle=\"--\", linewidth=1.6,\n",
    "           label=f\"Global average: {global_average:.2f}\")\n",
    "ax.set_xlim(0, 8.8)\n",
    "ax.set_xlabel(\"Happiness score\")\n",
    "ax.set_title(f\"The highest and lowest scores differ by {gap:.2f} points\")\n",
    "ax.grid(axis=\"x\", alpha=0.2)\n",
    "ax.set_axisbelow(True)\n",
    "ax.legend(loc=\"lower right\")\n",
    "fig.tight_layout()\n",
    "plt.show()\n",
    "print(f\"Global average: {global_average:.2f} | Score gap: {gap:.2f}\")\n"
   ]
  },
  {
