   "source": [
    "## 1. Regional happiness averages\n",
    "The horizontal bars use a zero baseline and highlight the region with the highest mean happiness score."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "ea6eabe5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Highest regional average: North America and ANZ (7.02)\n"
     ]
    }
   ],
   "source": [
    "regional_happiness = df.groupby(\"Region\")[\"Happiness_Score\"].mean().sort_values(ascending=True)\n",
    "leader = regional_happiness.idxmax()\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "bar_colors = [\"#2878B5\" if region == leader else \"#A7C7E7\" for region in regional_happiness.index]\n",
    "bars = ax.barh(regional_happiness.index, regional_happiness.values, color=bar_colors)\n",
    "ax.bar_label(bars, fmt=\"%.2f\", padding=4, fontsize=9)\n",
    "ax.set_xlim(0, max(regional_happiness.values) * 1.16)\n",
    "ax.set_xlabel(\"Average happiness score\")\n",
    "ax.set_title(f\"{leader} has the highest average happiness score\")\n",
    "ax.grid(axis=\"x\", alpha=0.2)\n",
    "ax.set_axisbelow(True)\n",
    "fig.tight_layout()\n",
    "plt.show()\n",
    "print(f\"Highest regional average: {leader} ({regional_happiness.max():.2f})\")\n"
   ]
  },
